# 复制成 .env 再填：cp .env.example .env
# 每个 key 从哪儿来，见 README「准备 key」一节。.env 已被 .gitignore 忽略，不要提交。

# ---- 建索引用的 LLM（必填其一）----------------------------------------------
# 方案 A：团队 Atria 网关（免费，只在 tailnet 内可达）
ATRIA_API_KEY=
ATRIA_BASE_URL=http://100.104.77.119:8100/v1
ATRIA_MODEL=Atria-Dawn-Preview
# 方案 B：任意 OpenAI 兼容端点（设置后优先于 ATRIA_*），例如直接用 DeepSeek：
# PIDX_LLM_BASE_URL=https://api.deepseek.com/v1
# PIDX_LLM_API_KEY=sk-...
# PIDX_LLM_MODEL=deepseek-v4-flash

# ---- 检索 / 问答用的 LLM（推荐，快约 10 倍）------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 检索默认用哪个：配置了 DEEPSEEK_API_KEY 时默认 deepseek，否则 default（= 建索引的模型）
# PIDX_SEARCH_BACKEND=deepseek

# ---- 向量（可选；不填则跳过，只影响文档 > 20 篇时的粗筛）-----------------------
SILICON_FLOW_API_KEY=
# 或者用 EmbeddingGemma 2（文本 + 图片同一个向量空间）：设置后替代上面的 bge-m3，
# 图片块会被切出来做向量，搜索结果里多一个 images 字段。换模型后旧向量会在启动时自动重算。
# PIDX_GEMMA_EMBED_URL=http://127.0.0.1:18300/v1
# PIDX_GEMMA_EMBED_MODEL=embeddinggemma-2
# PIDX_GEMMA_EMBED_API_KEY=

# ---- 扫描件 OCR（可选；不填则扫描件无法索引，文本型 PDF 不受影响）--------------
MINERU_API_KEY=
# 或者用自建 MinerU（mineru-api），设置后不再调用云端：
# PIDX_MINERU_URL=http://127.0.0.1:8000

# ---- 公网反代时的访问 token（可选；本机 / 内网直连不需要）---------------------
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# PIDX_PUBLIC_TOKEN=

# ---- 其他（一般不用改）------------------------------------------------------
# PIDX_DATA_DIR=./data
# PIDX_LLM_CONCURRENCY=24
# PIDX_INDEX_WORKERS=2
